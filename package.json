{
  "name": "ai-fitness-zone-roster",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:browser:m3": "playwright test tests/milestone_3_browser.spec.ts",
    "test:browser:m4": "playwright test tests/milestone_4_browser.spec.ts",
    "test:browser:m5": "playwright test tests/milestone_5_browser.spec.ts",
    "test:browser:m6": "playwright test tests/milestone_6_browser.spec.ts",
    "test:watch": "vitest",
    "db:test": "supabase test db",
    "db:test:concurrency": "powershell -NoProfile -ExecutionPolicy Bypass -File supabase/tests/concurrent_release_requests.ps1"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.52.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.18.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.31.0",
    "@playwright/test": "^1.62.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.1.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.31.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "jsdom": "^26.1.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.38.0",
    "vite": "^7.0.6",
    "vitest": "^3.2.4"
  }
}
